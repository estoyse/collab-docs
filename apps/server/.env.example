# Port the HTTP and WebSocket server listens on. Defaults to 3001 locally; the Docker image sets 8000.
PORT=3001

# libSQL database URL. Local development uses a SQLite file (its directory is created on start).
# Production uses Turso, e.g. libsql://collab-docs-<your-org>.turso.io
DATABASE_URL=file:data/documents.db

# Turso auth token. Required for libsql:// URLs, leave empty for file: URLs. Keep it secret.
DATABASE_AUTH_TOKEN=

# Comma-separated list of exact browser origins allowed to call the API and open WebSockets.
# Leave empty in development: no cross-origin HTTP access, and WebSockets accept any origin.
# Production example: CORS_ORIGIN=https://collab-docs.example.workers.dev
CORS_ORIGIN=
